{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opal",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "environment": {
        "DEBUG": "1"
      }
    },
    "search": {
      "type": "remote",
      "url": "https://search.example.com/mcp",
      "enabled": false
    }
  }
}
